rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    // Projects: Public read, Admin write
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: User read/write own, Admin read/write all
    match /orders/{orderId} {
      allow read, write: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /user_orders/{orderId} {
      allow read, write: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Drafts: Owner read/write
    match /drafts/{draftId} {
      allow read, write: if isSignedIn() && (resource.data.visitorId == request.auth.uid || request.resource.data.visitorId == request.auth.uid);
    }

    // Users: Owner read/write, Admin read all
    match /users/{userId} {
      allow read, write: if isAdmin() || isOwner(userId);
    }

    // CMS content: Public read, Admin write
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /media_resources/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Other collections (notifications, etc)
    match /notifications/{notificationId} {
       allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
       allow write: if isAdmin();
    }
    match /support_tickets/{ticketId} {
       allow read, write: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /wallets/{walletId} {
       allow read, write: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
    match /activity_logs/{logId} {
       allow read: if isAdmin();
       allow write: if false; // System only
    }
    match /chat_messages/{messageId} {
       allow read, write: if isSignedIn(); // Needs better hardening
    }
    match /reviews/{reviewId} {
       allow read: if true;
       allow write: if isSignedIn();
    }
    match /settings/{settingId} {
       allow read: if true;
       allow write: if isAdmin();
    }
  }
}
